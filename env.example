# ==============================================================================
# AlsaGeist Environment Configuration Template
# Copy to .env and configure: cp env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud Speech-to-Text & LLM Authentication (At least one recommended)
# ------------------------------------------------------------------------------
# Groq Whisper Large v3 (Fastest transcription latency for cloud STT)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini Flash (Alternative STT and conversational LLM fallback)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Persona & Dialogue Engine Configuration
# ------------------------------------------------------------------------------
# Active character personality profile (matches data/personalities/<name>.json)
PERSONALITY=grimjaw

# Enable dynamic LLM fallback for indeterminate prompts (true/false)
LLM_FALLBACK=false

# ------------------------------------------------------------------------------
# 3. Systemd Service Deployment (Used by scripts/install_service.sh)
# ------------------------------------------------------------------------------
# Linux user account that executes the systemd background daemon
ALSAGEIST_USER=pi

# Installation directory on the target Linux system
ALSAGEIST_DIR=/home/pi/alsageist

# ------------------------------------------------------------------------------
# 4. Hardware Audio Calibration (Digital Gain & Energy Thresholds)
# ------------------------------------------------------------------------------
# Output audio volume scaling factor (0.0 to 1.0, e.g. 0.8 for 80% volume)
VOLUME=0.8

# Digital microphone input gain multiplier (applied to raw captured frames)
MIC_GAIN=1.5

# Voice Activity Detection (VAD) minimum RMS energy threshold
VAD_THRESHOLD=0.0035

# ------------------------------------------------------------------------------
# 5. Local Offline Speech-to-Text (Optional)
# ------------------------------------------------------------------------------
# Path to local Vosk speech model directory for 100% offline transcription
# VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15

# ------------------------------------------------------------------------------
# 6. IPC Control Socket
# ------------------------------------------------------------------------------
# Local Unix domain socket for real-time control via scripts/alsageist_ctl.py
ALSAGEIST_SOCKET=/tmp/alsageist.sock
