# ==============================================================================
# AlsaGeist Environment Configuration Template
# Copy to .env and configure: cp env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud Speech-to-Text & LLM Authentication (At least one recommended)
# ------------------------------------------------------------------------------
# Uncomment a line and set a key to enable that service. Leave both commented to use
# only the offline Vosk speech model.
# Groq Whisper Large v3 (Fastest transcription latency for cloud STT)
# GROQ_API_KEY=

# Google Gemini Flash (Alternative STT and conversational LLM fallback)
# GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Persona & Dialogue Engine Configuration
# ------------------------------------------------------------------------------
# Active character personality profile (matches data/personalities/<name>.json)
PERSONALITY=grimjaw

# Enable dynamic LLM fallback for indeterminate prompts (true/false)
LLM_FALLBACK=false

# ------------------------------------------------------------------------------
# 3. Systemd Service Deployment (Used by scripts/setup_systemd_service.sh)
# ------------------------------------------------------------------------------
# Linux user account that executes the systemd background daemon
ALSAGEIST_USER=pi

# Installation directory on the target Linux system
ALSAGEIST_DIR=/home/pi/alsageist

# ------------------------------------------------------------------------------
# 4. Hardware Audio Calibration (Digital Gain & Energy Thresholds)
# ------------------------------------------------------------------------------
# Output audio volume scaling factor (0.0 to 1.0, e.g. 0.5 for 50% volume)
VOLUME=0.5

# Digital microphone input gain multiplier (applied to raw captured frames)
MIC_GAIN=1.5

# Voice Activity Detection (VAD) minimum RMS energy threshold
VAD_THRESHOLD=0.0035

# ------------------------------------------------------------------------------
# 5. Local Offline Speech-to-Text & Model Overrides (Optional)
# ------------------------------------------------------------------------------
# Path to local Vosk speech model directory for 100% offline transcription
# VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15

# Cloud model overrides (defaults: whisper-large-v3, openai/gpt-oss-120b)
# GROQ_STT_MODEL=whisper-large-v3
# GROQ_LLM_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 6. Hardware GPIO Pin & Button Timing Configuration (Optional)
# ------------------------------------------------------------------------------
# Raspberry Pi BCM GPIO pin assignments (defaults: Voice HAT V1)
# LED_PIN=25
# BUTTON_PIN=23
# BUTTON_HOLD_SEC=5.0
# BUTTON_SHUTDOWN_SEC=10.0

# ------------------------------------------------------------------------------
# 7. IPC Control Socket
# ------------------------------------------------------------------------------
# Local Unix domain socket for real-time control via scripts/alsageist_ctl.py.
# Default: /tmp/alsageist-<uid>/alsageist.sock (directory mode 0700, socket mode 0600).
# The daemon and scripts/alsageist_ctl.py must run as the same user.
# ALSAGEIST_SOCKET=/path/to/alsageist.sock

# ------------------------------------------------------------------------------
# 8. Synthesized Speech Cache (Optional)
# ------------------------------------------------------------------------------
# Disk cache size limit in MB; least recently used files are deleted beyond it
# ALSAGEIST_CACHE_MAX_MB=1024

# ------------------------------------------------------------------------------
# 9. Interaction Logs (Optional)
# ------------------------------------------------------------------------------
# Each log file rotates at this size (MB); LOG_BACKUPS older copies are kept
# LOG_MAX_MB=5
# LOG_BACKUPS=3
# Set to false to stop storing what visitors and the persona say; timings and intents are still logged
# LOG_TRANSCRIPTS=true

# ------------------------------------------------------------------------------
# 10. Raspberry Pi Power & Thermal Warnings (Optional)
# ------------------------------------------------------------------------------
# Seconds between checks for under-voltage and CPU throttling; 0 disables the monitor
# THROTTLE_CHECK_SEC=60
# Minimum seconds between repeated warnings while throttling continues
# THROTTLE_WARN_SEC=900
# Say an in-character line out loud while the supply voltage is low (true/false)
# LOW_POWER_ANNOUNCE=true
# Minimum seconds between spoken low-power lines
# LOW_POWER_ANNOUNCE_SEC=3600
