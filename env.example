# ==============================================================================
# AlsaGeist Environment Configuration Template
# Copy to .env and configure: cp env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud Speech-to-Text & LLM Authentication (At least one recommended)
# ------------------------------------------------------------------------------
# Leave blank for pure offline mode (Vosk STT and local regex intents)
GROQ_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Persona & Dialogue Engine Configuration
# ------------------------------------------------------------------------------
# Active character personality profile (matches data/personalities/<name>.json)
PERSONALITY=grimjaw

# Dialogue engine: 'intent' (fast offline regex banter) or 'llm' (neural conversational LLM)
ENGINE=intent

# Enable dynamic LLM fallback for indeterminate prompts (true/false)
LLM_FALLBACK=false

# Spoken response when LLM fallback fails or is unavailable (optional)
LLM_FALLBACK_RESPONSE=

# Comma-separated list of blocked words for LLM outputs (optional)
LLM_BLOCKED_WORDS=

# ------------------------------------------------------------------------------
# 3. Systemd Service Deployment (Used by scripts/setup_systemd_service.sh)
# ------------------------------------------------------------------------------
# Linux user account that executes the systemd background daemon
ALSAGEIST_USER=pi

# Installation directory on the target Linux system
ALSAGEIST_DIR=/home/pi/alsageist

# ------------------------------------------------------------------------------
# 4. Hardware Audio Calibration (Digital Gain & Energy Thresholds)
# ------------------------------------------------------------------------------
# Output audio volume scaling factor (0.0 to 1.0, e.g. 0.5 for 50% volume)
VOLUME=0.5

# Digital microphone input gain multiplier (applied to raw captured frames)
MIC_GAIN=1.5

# Voice Activity Detection (VAD) minimum RMS energy threshold
VAD_THRESHOLD=0.0035

# Speech must exceed the ambient noise floor by this factor
VAD_MULTIPLIER=2.2

# Shortest speech in seconds that counts as an utterance
MIN_SPEECH_SEC=0.15

# Trailing silence in seconds that marks the end of an utterance
SILENCE_TIMEOUT=0.9

# Piper TTS speech rate scale (1.0 = normal rate; lower is faster)
TEMPO=1.0

# Piper TTS phoneme noise variance scale (default: 0.667)
NOISE=0.667

# ------------------------------------------------------------------------------
# 5. Speech Models & Overrides (Local & Cloud)
# ------------------------------------------------------------------------------
# Override Piper ONNX voice model path (leave blank to resolve from personality profile)
MODEL_PATH=

# Path to local Vosk speech model directory for 100% offline transcription
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15

# Cloud model overrides (defaults: whisper-large-v3, openai/gpt-oss-120b)
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=openai/gpt-oss-120b
GEMINI_STT_MODEL=gemini-2.0-flash
GEMINI_LLM_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 6. Hardware GPIO Pin & Button Timing Configuration
# ------------------------------------------------------------------------------
# Raspberry Pi BCM GPIO pin assignments (defaults: Voice HAT V1)
LED_PIN=25
BUTTON_PIN=23
BUTTON_HOLD_SEC=5.0
BUTTON_SHUTDOWN_SEC=10.0
BUTTON_SHUTDOWN_ENABLED=true

# ------------------------------------------------------------------------------
# 7. IPC Control Socket
# ------------------------------------------------------------------------------
# Local Unix domain socket for real-time control via scripts/alsageist_ctl.py
# Default: /tmp/alsageist-<uid>/alsageist.sock (directory mode 0700, socket mode 0600)
ALSAGEIST_SOCKET=

# ------------------------------------------------------------------------------
# 8. Synthesized Speech Cache
# ------------------------------------------------------------------------------
# Disk cache size limit in MB; least recently used files are deleted beyond it
ALSAGEIST_CACHE_MAX_MB=1024

# Directory path for disk-cached WAV files (default: models/cache)
ALSAGEIST_CACHE_DIR=models/cache

# ------------------------------------------------------------------------------
# 9. Interaction Logs & Privacy
# ------------------------------------------------------------------------------
# Directory path for interaction logs (default: logs/)
LOG_DIR=logs

# Each log file rotates at this size (MB); LOG_BACKUPS older copies are kept
LOG_MAX_MB=5
LOG_BACKUPS=3

# Set to true to store what visitors and the persona say (also shown on the console); by default
# only timings, intents and audio levels are logged
LOG_TRANSCRIPTS=false

# ------------------------------------------------------------------------------
# 10. Raspberry Pi Power & Thermal Warnings
# ------------------------------------------------------------------------------
# Watch for under-voltage and CPU throttling at all: log warnings and speak a line (true/false)
LOW_POWER_MONITOR=true

# Seconds between checks for under-voltage and CPU throttling
THROTTLE_CHECK_SEC=60

# Minimum seconds between repeated warnings while throttling continues
THROTTLE_WARN_SEC=900

# Say an in-character line out loud while the supply voltage is low (true/false)
LOW_POWER_ANNOUNCE=true

# Minimum seconds between spoken low-power lines
LOW_POWER_ANNOUNCE_SEC=3600

# ------------------------------------------------------------------------------
# 11. Weather Configuration
# ------------------------------------------------------------------------------
# Weather comes from wttr.in. Setting WEATHER_LOCATION turns weather on and sends that place name
WEATHER_LOCATION=

# Weather is off while WEATHER_LOCATION is empty. true turns it on without a location (IP-based)
WEATHER_ENABLED=false

# ------------------------------------------------------------------------------
# 12. Docker Host Group IDs & GPIO Device (written by scripts/setup_docker.sh)
# ------------------------------------------------------------------------------
AUDIO_GID=29
GPIO_GID=997
GPIO_DEVICE=/dev/gpiochip0

# ------------------------------------------------------------------------------
# 13. Spoken Voice Command Security
# ------------------------------------------------------------------------------
# Verbal password required for privileged voice operations (shutdown, mode switches,
# fallback toggles). Prevents visitors from shutting down the device or changing modes.
# Set to 'none', 'off', or leave blank to disable password protection.
VOICE_COMMAND_PASSWORD=alsageist

# ------------------------------------------------------------------------------
# 14. Wi-Fi Failover Configuration (Optional)
# ------------------------------------------------------------------------------
# Semicolon-separated list of candidate Wi-Fi networks in the format SSID1:PASSWORD; SSID2:PASSWORD
# On service startup, if the system cannot connect to its known network, it scans the air and attempts
# to connect to these until successful. Spoken statuses are announced during the process.
# Saved NetworkManager connections are also automatically included as candidates.
WIFI_FALLBACK_NETWORKS=

# ------------------------------------------------------------------------------
# 15. Startup Boot Announcement Configuration
# ------------------------------------------------------------------------------
# Vocalize full diagnostic details (product name, version, Wi-Fi SSID, IP, volume) on startup.
# Set to 'false' to only vocalize the concise character greeting.
VERBOSE_BOOT_ANNOUNCEMENT=true

