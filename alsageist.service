[Unit]
Description=AlsaGeist Autonomous Conversational Halloween Display
After=sound.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ALSAGEIST_USER}}
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-{{ALSAGEIST_DIR}}/.env
WorkingDirectory={{ALSAGEIST_DIR}}
ExecStart={{ALSAGEIST_DIR}}/venv/bin/python3 {{ALSAGEIST_DIR}}/main.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
