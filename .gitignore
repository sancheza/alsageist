# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Secrets & Environment variables
.env.*
!.env
!.env.example

# Logs & Runtime telemetry
logs/*.log
logs/*.jsonl
!logs/.gitkeep

# Large neural model weights & audio cache (download/generate on demand)
models/piper/*.onnx
!models/piper/*.onnx.json
!models/piper/.gitkeep
models/cache/*.npy
!models/cache/.gitkeep
models/vosk*

# Root scratch, preview, and socket files
/preview_*.wav
*.tmp
*.bak
*.sock
*.npy
